{
  "manifest_version": 3,
  "name": "Fox Vize - Çin Vize Otomasyonu",
  "version": "5.0.0",
  "description": "Fox Vize sistemi ile Çin konsolosluğu vize başvuru formlarını otomatik dolduran araç",
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  
  "host_permissions": [
    "https://consular.mfa.gov.cn/*",
    "https://*.vercel.app/*",
    "https://foxvize.online/*",
    "https://*.foxvize.online/*",
    "http://localhost:3000/*"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://consular.mfa.gov.cn/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fox Vize Otomasyonu",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png", 
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}